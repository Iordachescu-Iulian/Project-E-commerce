# Project-local MySQL instance started with `npm run db:start`.
# If you override DB_PORT for the scripts, update the port in this URL too.
DATABASE_URL="mysql://hexora:hexora_dev_password@127.0.0.1:3307/hexora"

# Session signing secret. Generate a random value, never commit the real one.
AUTH_SECRET="replace-with-a-long-random-secret"

# Stripe test mode placeholders. Fill these locally when testing payments.
STRIPE_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Public application URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
